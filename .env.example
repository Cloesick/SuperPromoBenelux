# Affiliate links — set these to your affiliate tracking URLs.
# When set, they override the default direct links to retailer websites.
# Example: AFFILIATE_AH=https://tc.tradetracker.net/?c=12345&m=67890&a=111111&r=&u=https%3A%2F%2Fwww.ah.be%2Fbonus

AFFILIATE_AH=
AFFILIATE_LIDL=
AFFILIATE_DELHAIZE=
AFFILIATE_COLRUYT=
AFFILIATE_ALDI=
AFFILIATE_ACTION=

# Microsoft Clarity — behavior analytics (heatmaps, session recordings)
# Get your project ID from https://clarity.microsoft.com/
# Only loaded after user accepts cookies (GDPR compliant)
NEXT_PUBLIC_CLARITY_ID=

# Vercel Analytics + Speed Insights are enabled automatically (no config needed)
# They are cookie-less and privacy-friendly — no consent required

# Google Search Console — site ownership verification (HTML meta-tag method)
# Add the property in https://search.google.com/search-console, choose the
# "HTML tag" method, and paste ONLY the content="..." token value here.
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Folder page image storage -------------------------------------------
# public/ is not committed and folder screenshots are ~140MB/week, so page
# images are uploaded to Vercel Blob and the folder JSON stores absolute URLs.
# Without this token the scraper falls back to writing /screenshots/<file>
# locally, which works in development but renders nothing in production.
BLOB_READ_WRITE_TOKEN=

# --- Scraper tuning -------------------------------------------------------
# Delay between sequential navigations, ms (default 1500). Set 0 in tests.
SCRAPE_DELAY_MS=
# Device pixel ratio for leaflet captures, 1-4 (default 3).
SCREENSHOT_SCALE=
# Max pages captured per folder before giving up (default 60). Capture stops
# earlier when the viewer repeats a page.
MAX_SCREENSHOT_PAGES=
