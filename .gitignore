# scraped data
*.traineddata

# full-resolution OCR sources (regenerated by the scraper, never served)
/data/ocr-src

# SQLite deal archive: rewritten wholesale by every scrape run, so tracking it
# bloats history the same way the unpruned screenshots did (360 KB -> 454 KB in
# a single session). Nothing at runtime reads it: only src/lib/productsDb.ts
# writes it from the scraper, and it self-creates its schema on first open, so
# a deploy never needs the file to be present. -wal/-shm are WAL sidecars.
/data/products.db
/data/products.db-wal
/data/products.db-shm

# Nested checkout of the DIY sibling site; kept from the live repo.
diysuperpromobelgiebram/

# Leaflet page images live in Vercel Blob, not git. The scraper uploads them
# and folder JSON stores absolute URLs; committing them added ~200 MB per run
# for files regenerated weekly and never diffed.
/public/screenshots

# Semgrep Guardian writes auth state here; never commit it
.semgrep/
